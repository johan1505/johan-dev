{
	"name": "infra",
	"version": "0.0.0",
	"private": true,
	"bin": {
		"infra": "bin/infra.js"
	},
	"scripts": {
		"build": "tsc",
		"synth": "tsc && cdk synth",
		"watch": "tsc -w",
		"cdk": "cdk",
		"deploy": "npm run test && tsc && cdk synth && cdk deploy --all --require-approval never",
		"dev:fix": "biome lint --write . && biome format --write .",
		"test:format": "biome format .",
		"test:type-check": "tsc --noEmit",
		"test": "npm-run-all test:*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/node": "latest",
		"aws-cdk": "latest",
		"dotenv": "latest",
		"npm-run-all": "latest",
		"ts-node": "latest",
		"typescript": "latest"
	},
	"dependencies": {
		"aws-cdk-lib": "latest",
		"constructs": "latest",
		"source-map-support": "latest"
	}
}
