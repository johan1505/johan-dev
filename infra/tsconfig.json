{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"lib": [
			"ES2022"
		],
		"rootDir": ".",
		"outDir": "./dist",
		"inlineSourceMap": true,
		"inlineSources": true,
		"experimentalDecorators": true,
		"strictPropertyInitialization": false
	},
	"include": [
		"bin/**/*",
		"lib/**/*"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
