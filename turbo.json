{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": []
		},
		"test": {
			"dependsOn": [],
			"outputs": []
		},
		"lint": {
			"dependsOn": [],
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"deploy": {
			"dependsOn": [
				"build",
				"test"
			],
			"cache": false
		}
	},
	"globalPassThroughEnv": [
		"NODE_ENV",
		"CI"
	]
}
